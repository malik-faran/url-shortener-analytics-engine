# --- Storage ---
# Leave DATABASE_URL unset to use the zero-dependency JSON file store.
DATABASE_URL=
# Optional path override for the JSON store (default: backend/data/store.json)
DATA_FILE=

# --- Cache ---
# Leave REDIS_URL unset to use the in-memory TTL cache.
REDIS_URL=

# --- App ---
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
