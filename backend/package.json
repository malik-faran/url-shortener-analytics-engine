{
  "name": "url-shortener-backend",
  "version": "1.0.0",
  "description": "High-Throughput URL Shortener & Real-Time Analytics Engine - Backend",
  "main": "src/app.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "jest --verbose",
    "test:ci": "jest --verbose --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "ua-parser-js": "^0.7.32"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
